# quantification results, and two sample editor states. Full micro-CT volumes
# and labelled volumes are distributed separately (see README → Data).
data/image_volumes/
data/predicted_volumes/
data/pores_cleaned/
data/cluster_state/
data/corrected_cluster_state/
data/final_foram_state/
data/analysis/
data/visualizations/
*.npy

# Exception: sample editor states are small and ARE tracked
!data/samples/editor_state/*.npz

